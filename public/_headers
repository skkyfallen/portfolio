# Cloudflare _headers
# Next copies this verbatim into out/; Cloudflare parses it natively.
# These replace next.config `headers()`, which Next DROPS under output: "export".

# Security headers, all routes.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# The OG image is emitted WITHOUT a file extension (out/opengraph-image).
# Without this, Cloudflare serves it as application/octet-stream and strict
# crawlers (X, Facebook, Slack) reject the preview card.
/opengraph-image
  Content-Type: image/png

# Content-hashed build assets are safe to cache forever.
# HTML deliberately keeps Cloudflare's default max-age=0, must-revalidate
# so redeploys are picked up immediately.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/resume.pdf
  Cache-Control: public, max-age=3600